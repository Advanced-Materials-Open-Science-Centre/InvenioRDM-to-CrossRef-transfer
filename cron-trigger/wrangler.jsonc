{
  "name": "new-records-cron-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Telegram's webhook posts to https://new-records-cron-trigger.<subdomain>.workers.dev/telegram
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    // 19:17 in Kyiv is 17:17 UTC in winter and 16:17 UTC in summer
    "crons": ["17 16 * * *", "17 17 * * *"]
  },
  "vars": {
    "REPOSITORY": "Advanced-Materials-Open-Science-Centre/InvenioRDM-to-CrossRef-transfer",
    "WORKFLOW": "new-records.yml",
    "BRANCH": "master"
  },
  "observability": {
    "enabled": true
  }
}
